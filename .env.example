# =============================================================================
# Aegis Protocol — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with your API credentials.
# All variables are optional for offline development. Missing credentials are
# reported as AUTH_REQUIRED; public sources may remain available. Production
# never treats missing-provider data or a mock as live evidence.
# =============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGIN=*
LOG_LEVEL=INFO
ADMIN_API_TOKEN=

# ── AI Reasoning & Model APIs (Google Gemini) ─────────────────────────────────
# Primary API key for Gemini 1.5 Flash / Pro forensic reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Optional failover keys for high-throughput round-robin rotation
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Bounded advisory AI: suggestions only, never fabricated evidence/verdicts.
# auto uses live configured credentials; false disables source suggestions.
AEGIS_SOURCE_PLANNER_LLM_ENABLED=false
AEGIS_EVIDENCE_ADVISOR_ENABLED=false

# ── Database & Persistence (Supabase / SQLite) ───────────────────────────────
# When Supabase credentials are provided, cloud persistence is used.
# If omitted, Aegis transparently defaults to local SQLite persistence.
SUPABASE_URL=https://your-project.supabase.co
# Prefer an explicit server service-role key for backend persistence writes.
# SUPABASE_KEY is a legacy server-key alias, not an anonymous/public-key slot.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public/anonymous credentials are never promoted to a backend write credential.
SUPABASE_ANON_KEY=
# Canonical path. The legacy AEGIS_SQLITE_PATH alias remains supported.
# Leave unset to reuse backend/data/aegis_local.db without migrating or deleting it.
# SQLITE_DB_PATH=backend/data/aegis_local.db
# AEGIS_DOSSIER_DIR=backend/data/dossiers

# ── External Scraping & Financial Services ───────────────────────────────────
# Optional Apify token for enhanced social extraction
APIFY_TOKEN=

# Optional Yahoo Finance API Key (standard quotes use yfinance zero-cost endpoints)
YF_API_KEY=

# ── Agent Reach Capability Layer ─────────────────────────────────────────────
# Enables/disables live internet evidence acquisition across all sentinels
AGENT_REACH_ENABLED=true

# Per-channel HTTP fetch timeout in seconds
AGENT_REACH_TIMEOUT=12.0

# Maximum concurrent channels queried per domain scan
AGENT_REACH_MAX_CHANNELS=6

# Maximum evidence items retrieved per channel
AGENT_REACH_MAX_RESULTS=10

# Whole investigations may take up to two minutes; individual HTTP calls remain
# bounded. Multi-step provider searches / source reads get 15s, not 5s total.
RESEARCH_MAX_TOTAL_LATENCY_SECONDS=120
RESEARCH_CHANNEL_TIMEOUT_SECONDS=15
# Optional environment-specific overrides (take precedence over the above):
# SERVER_RESEARCH_TIMEOUT=120
# LOCAL_RESEARCH_TIMEOUT=120
# SERVER_RESEARCH_CHANNEL_TIMEOUT=15
# LOCAL_RESEARCH_CHANNEL_TIMEOUT=15

# Optional explicitly authorized advice only: 160 output tokens, one attempt / 2s.
# Requires a separately model-verified advisory_run and investigation_scope.
# Shared ledger: one call/investigation, three/run; no automatic quota probes.
# Does not change the separately configured synthesis model. Quota failures
# fail closed with cooldown; do not rotate keys to evade project limits.
LLM_ADVISORY_MODEL=gemini-2.5-flash-lite

# Optional provider credentials. Public operations remain independently
# visible at /api/agent-reach/capabilities and /api/readyz.
GITHUB_TOKEN=
LINKEDIN_COOKIE=
XUEQIU_COOKIE=
XIAOHONGSHU_COOKIE=
INSTAGRAM_COOKIE=
FACEBOOK_COOKIE=
# Optional paid article reader. Never needed for native-only investigations.
# Public HTTPS endpoint only; no private/localhost SSRF exception. Configured
# does not mean provider health or research quality has been verified.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
# FIRECRAWL_BASE_URL is a legacy alias; API_BASE_URL takes precedence.
# Huginn is unused/disabled for this milestone. Do not enable its deferred
# monitoring scaffold until its security/provenance review is completed.
HUGINN_ENABLED=false
HUGINN_WEBHOOK_SECRET=
BOSS_CDP_PORT=
GROQ_API_KEY=

# Reddit direct access is policy-blocked unless the operator has approved
# access. Do not enable this merely to bypass provider restrictions.
REDDIT_APPROVED_ACCESS=false

# Background RSS polling can be disabled for API-only or multi-worker setups.
RSS_INGESTION_ENABLED=true

# Acquisition-first research capacities; this selects bounds, not evidence quality.
# QUICK: 24 candidates / 6 reads / 60s. STANDARD: 60 / 14 / 150s.
# DEEP: 100 / 24 / 240s. Explicit lower request/server limits are respected.
AEGIS_RESEARCH_PROFILE=STANDARD
# Additional lower native HTTP-admission cap (includes native retries/redirects).
# Mode hard caps are QUICK 40, STANDARD 80, DEEP 120; this cannot raise them.
AEGIS_HARVEST_HTTP_CAP=120
# Optional owned-system-temp snapshots for offline requalification, not archives.
# Default false: raw pool is returned in research_corpus. Audits explicitly persist.
AEGIS_RAW_POOL_PERSIST=false

# ── Urgent Alerting & Push Notifications (Twilio / Webhooks) ─────────────────
# Optional Twilio SMS / WhatsApp credentials for critical VIP alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
