# =============================================================================
# Aegis Protocol — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with your API credentials.
# All variables are optional for offline development. Missing credentials are
# reported as AUTH_REQUIRED; public sources may remain available. Production
# never treats missing-provider data or a mock as live evidence.
# =============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGIN=*
LOG_LEVEL=INFO
ADMIN_API_TOKEN=

# ── AI Reasoning & Model APIs (Google Gemini) ─────────────────────────────────
# Primary API key for Gemini 1.5 Flash / Pro forensic reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Optional failover keys for high-throughput round-robin rotation
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Bounded advisory AI: suggestions only, never fabricated evidence/verdicts.
# auto uses live configured credentials; false disables source suggestions.
AEGIS_SOURCE_PLANNER_LLM_ENABLED=auto
AEGIS_EVIDENCE_ADVISOR_ENABLED=true

# ── Database & Persistence (Supabase / SQLite) ───────────────────────────────
# When Supabase credentials are provided, cloud persistence is used.
# If omitted, Aegis transparently defaults to local SQLite persistence.
SUPABASE_URL=https://your-project.supabase.co
# Prefer an explicit server service-role key for backend persistence writes.
# SUPABASE_KEY is a legacy server-key alias, not an anonymous/public-key slot.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public/anonymous credentials are never promoted to a backend write credential.
SUPABASE_ANON_KEY=
# Canonical path. The legacy AEGIS_SQLITE_PATH alias remains supported.
# Leave unset to reuse backend/data/aegis_local.db without migrating or deleting it.
# SQLITE_DB_PATH=backend/data/aegis_local.db
# AEGIS_DOSSIER_DIR=backend/data/dossiers

# ── External Scraping & Financial Services ───────────────────────────────────
# Optional Apify token for enhanced social extraction
APIFY_TOKEN=

# Optional Yahoo Finance API Key (standard quotes use yfinance zero-cost endpoints)
YF_API_KEY=

# ── Agent Reach Capability Layer ─────────────────────────────────────────────
# Enables/disables live internet evidence acquisition across all sentinels
AGENT_REACH_ENABLED=true

# Per-channel HTTP fetch timeout in seconds
AGENT_REACH_TIMEOUT=12.0

# Maximum concurrent channels queried per domain scan
AGENT_REACH_MAX_CHANNELS=6

# Maximum evidence items retrieved per channel
AGENT_REACH_MAX_RESULTS=10

# Optional provider credentials. Public operations remain independently
# visible at /api/agent-reach/capabilities and /api/readyz.
GITHUB_TOKEN=
LINKEDIN_COOKIE=
XUEQIU_COOKIE=
XIAOHONGSHU_COOKIE=
INSTAGRAM_COOKIE=
FACEBOOK_COOKIE=
BOSS_CDP_PORT=
GROQ_API_KEY=

# Reddit direct access is policy-blocked unless the operator has approved
# access. Do not enable this merely to bypass provider restrictions.
REDDIT_APPROVED_ACCESS=false

# Background RSS polling can be disabled for API-only or multi-worker setups.
RSS_INGESTION_ENABLED=true

# ── Urgent Alerting & Push Notifications (Twilio / Webhooks) ─────────────────
# Optional Twilio SMS / WhatsApp credentials for critical VIP alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
